      "parameters": {
        "jsCode": "// รวมข่าว 5 อันดับแรกเป็นข้อความเดียว\nconst items = $input.all();\nconst lines = items.slice(0, 5).map((item, i) => `${i + 1}. ${item.json.title}\n${item.json.link}`);\nreturn [{ json: { digest: lines.join(\"\n\n\") } }];"
      },
